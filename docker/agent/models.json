{
  "providers": {
    "lm-server": {
      "baseUrl": "${LM_SERVER_BASE_URL}",
      "apiKey": "lm-studio",
      "models": [
        {
          "id": "${MODEL}",
          "name": "Local LM",
          "api": "openai-completions",
          "contextWindow": "${CTX_SIZE}",
          "maxTokens": "${MAX_TOKENS}",
          "reasoning": "${REASONING}",
          "input": ["text", "image"]
        }
      ]
    }
  }
}
